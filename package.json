{
  "name": "ghostlink",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental Solana zero-knowledge identity and policy-controlled pockets.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "overrides": {
      "@solana/web3.js": "^1.98.0",
      "underscore": "1.13.8",
      "@solana/web3.js>jayson": "5.0.0"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "pack:sdk": "pnpm --filter @ghostlink/sdk... build && node scripts/package-sdk.mjs",
    "test:package": "node scripts/package-sdk.mjs --test",
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r test",
    "test:vectors": "pnpm --filter @ghostlink/common test",
    "typecheck": "pnpm -r typecheck"
  }
}
