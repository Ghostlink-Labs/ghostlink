{
  "name": "@ghostlink/verify",
  "version": "0.1.0",
  "description": "Server-side GhostLink login verification: check a proof, the domain it is bound to, and the roots it was built against — no transaction needed.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "keys"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostlink/common": "workspace:*",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@noble/curves": "^1.7.0",
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
