{
  "name": "@ghostlink/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Localnet end-to-end: boots the services in-process against a real validator and walks the whole user journey over HTTP — register, snapshot, prove, open a session, fund through the Blink, fill through the solver, sweep home.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "e2e": "node dist/run.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostlink/bot": "workspace:*",
    "@ghostlink/actions": "workspace:*",
    "@ghostlink/common": "workspace:*",
    "@ghostlink/indexer": "workspace:*",
    "@ghostlink/relayer": "workspace:*",
    "@ghostlink/sdk": "workspace:*",
    "@ghostlink/service-kit": "workspace:*",
    "@ghostlink/solver": "workspace:*",
    "@ghostlink/verify": "workspace:*",
    "@ghostlink/watcher": "workspace:*",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.0",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "snarkjs": "^0.7.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
