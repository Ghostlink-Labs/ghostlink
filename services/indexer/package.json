{
  "name": "@ghostlink/indexer",
  "version": "0.1.0",
  "private": true,
  "description": "Rebuilds the registry and census Merkle trees from on-chain events and serves paths and roots. Carries no trust: the SDK verifies every served path against an on-chain root.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./store": "./dist/store.js",
    "./poller": "./dist/poller.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostlink/common": "workspace:*",
    "@ghostlink/service-kit": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
