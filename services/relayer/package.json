{
  "name": "@ghostlink/relayer",
  "version": "0.1.0",
  "private": true,
  "description": "The fee payer. Accepts registration bundles, session openings, census cranks and owner actions; builds and pays for the transaction. Carries liveness only — every instruction it submits carries the user's signature or proof.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./policy": "./dist/policy.js",
    "./journal": "./dist/journal.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostlink/common": "workspace:*",
    "@ghostlink/service-kit": "workspace:*",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
