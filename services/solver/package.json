{
  "name": "@ghostlink/solver",
  "version": "0.1.0",
  "private": true,
  "description": "Reference solver: receives signed intents, quotes a route, and submits precompile + fill_begin + route + fill_end as one atomic transaction. A bad solver can only lose its own funds.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server.js",
    "./validate": "./dist/validate.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@ghostlink/common": "workspace:*",
    "@ghostlink/service-kit": "workspace:*",
    "@noble/curves": "^1.7.0",
    "@noble/hashes": "^1.6.0",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  }
}
